# Database
DB_URL=jdbc:postgresql://localhost:5432/parcelgo
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=parcelgo-super-secret-key-change-in-production-min-256-bits
JWT_EXPIRATION=86400000

# Email (Gmail SMTP example)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=noreply@parcelgo.in

# SMS via Twilio (free trial: https://www.twilio.com)
# Sign up → get Account SID, Auth Token, and a trial phone number
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
